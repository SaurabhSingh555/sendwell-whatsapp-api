# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Dashboard → Project Settings → API Keys → service_role key
# SECRET: server only. Never use NEXT_PUBLIC_ or expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Must match the public bucket created by supabase/setup.sql
SUPABASE_BUCKET=whatsapp-media

# Optional: private persistent directory for WhatsApp Web credentials.
# Default: .wa-auth in the project root. Use an absolute path for deployments.
# WA_AUTH_DIR=/path/to/persistent/private/whatsapp-auth
